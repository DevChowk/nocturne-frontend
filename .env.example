VITE_API_URL=your_api_url_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GAMES_ENABLED=true
# Camera reactions (off by default). Shows the opt-in toggle in Settings; the
# backend's REACTIONS_ENABLED + GIPHY_API_KEY must also be set for it to work.
# Models are fetched once with ./scripts/fetch-mediapipe-models.sh.
VITE_REACTIONS_ENABLED=false
